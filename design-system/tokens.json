{
  "$description": "No Handoff design tokens (W3C Design Tokens-formaat). Bron: nohandoff.nl, november 2026. Wijzigen via pull request; daarna: node scripts/build-tokens.mjs",
  "color": {
    "$type": "color",
    "ink":     { "$value": "#15131a", "$description": "Koppen en hoofdtekst" },
    "body":    { "$value": "#55525c", "$description": "Lopende tekst" },
    "muted":   { "$value": "#8a8791", "$description": "Hulptekst, labels" },
    "line":    { "$value": "#ebe8ef", "$description": "Randen en scheidingslijnen" },
    "bg":      { "$value": "#fbfaf8", "$description": "Pagina-achtergrond (warm)" },
    "card":    { "$value": "#ffffff", "$description": "Kaarten" },
    "soft":    { "$value": "#f6f2fb", "$description": "Zachte violet vlakken, geselecteerd" },
    "navy":    { "$value": "#2c2a5a" },
    "accent":  { "$value": "#8b5cf6", "$description": "Violet, primaire actie en accent" },
    "accent-strong": { "$value": "#6d3fe0", "$description": "Violet voor tekst op licht (contrast)" },
    "pink":    { "$value": "#ff4fa3" },
    "orange":  { "$value": "#ff6a3d" },
    "danger":  { "$value": "#c2264b", "$description": "Foutmelding" },
    "success": { "$value": "#1f7a55", "$description": "Gelukt-melding" },
    "white":   { "$value": "#ffffff" }
  },
  "gradient": {
    "$type": "gradient",
    "glow": { "$value": "radial-gradient(120% 95% at 20% 110%, #ff6a3d 0%, #ff4fa3 36%, #8b5cf6 66%, #2c2a5a 100%)", "$description": "Alleen voor grote momenten: hero, uitslag, afsluiting" },
    "line": { "$value": "linear-gradient(90deg, #ff6a3d, #ff4fa3 45%, #8b5cf6)" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": "\"Bricolage Grotesque\", \"Inter\", system-ui, sans-serif" },
    "text":    { "$value": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif" },
    "mono":    { "$value": "\"JetBrains Mono\", ui-monospace, Menlo, monospace" }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": "22px" },
    "field": { "$value": "14px" },
    "pill": { "$value": "99px" }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "6px" },
    "sm": { "$value": "12px" },
    "md": { "$value": "22px" },
    "lg": { "$value": "36px" },
    "xl": { "$value": "64px" }
  }
}
